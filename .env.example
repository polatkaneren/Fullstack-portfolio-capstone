# Copy this file to .env and adjust as needed. Never commit .env.

# Port the server listens on. Hosting platforms usually set this for you.
PORT=3001

# "development" locally, "production" when deployed.
NODE_ENV=development

# Only needed if the frontend is hosted on a different domain than the API.
# Comma-separated list, e.g. https://my-portfolio.netlify.app
CORS_ORIGIN=
